PORT=4000
DATABASE_URL=postgres://postgres:kakashi101@localhost:5432/vido_db
JWT_SECRET=change_this_to_a_long_random_string

# Domen sozlamalari — production'da getvido.uz ishlatiladi
CLIENT_ORIGIN=https://getvido.uz
# Bir nechta manbaga ruxsat berish uchun vergul bilan ajrating (masalan, local dev + prod):
# CLIENT_ORIGIN=http://localhost:5173,https://getvido.uz
APP_PUBLIC_URL=https://getvido.uz

# QR kod video ustiga yozib qo'yiladigan "asosiy sayt" manzili ham APP_PUBLIC_URL orqali olinadi.

# --- MAJBURIY: Redis (BullMQ navbat tizimi uchun) ---
# Mahalliy Redis: oddiy TLS'siz ulanish (masalan `apt install redis-server` orqali o'rnatilgan)
REDIS_URL=redis://localhost:6379
REDIS_TLS=false
# Bulutli Redis (Upstash va h.k.) ishlatilsa:
# REDIS_URL=rediss://default:xxxxx@your-instance.upstash.io:6379
# REDIS_TLS=true

# --- Google orqali kirish (ixtiyoriy, agar sozlanmasa oddiy email/parol bilan kirish ishlayveradi) ---
GOOGLE_CLIENT_ID="462238723241-0q7plckonmlj0320513m3q6k1dksrvo3.apps.googleusercontent.com"

